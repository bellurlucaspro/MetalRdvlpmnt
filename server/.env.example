# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/metalr?retryWrites=true&w=majority

# JWT
JWT_SECRET=votre_secret_super_securise_changez_moi
JWT_EXPIRE=7d

# Cloudinary (images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (pour CORS)
FRONTEND_URL=http://localhost:5173

# Admin credentials (pour créer le premier compte)
ADMIN_EMAIL=admin@metalr.com
ADMIN_PASSWORD=changez_moi_en_production
